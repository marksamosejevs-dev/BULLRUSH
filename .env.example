# ---------------------------------------------------------------------------
# BULLRUSH Internal E-Commerce Agent — environment variables
#
# Copy this file to .env for local development:
#   cp .env.example .env
#
# Never commit a real .env file. This file only ever contains placeholders.
# ---------------------------------------------------------------------------

# Required. PostgreSQL connection string used by Prisma.
DATABASE_URL="postgresql://user:password@localhost:5432/bullrush_agent"

# ---------------------------------------------------------------------------
# Pipeline configuration (Phase 2). Non-secret — safe defaults if unset.
# ---------------------------------------------------------------------------

# Market the Scout/Sourcing pipeline targets.
DEFAULT_MARKET="US"
# Destination used for real shipping quotes.
DEFAULT_VALIDATION_COUNTRY="US"
DEFAULT_VALIDATION_POSTAL_CODE="90210"

# Validator recommendation thresholds, out of 100 (overallScore * 10).
VALIDATION_TEST_THRESHOLD=75
VALIDATION_WATCH_THRESHOLD=55

# ---------------------------------------------------------------------------
# Research providers (Part 1) — services/research/providers
# Each is independently optional. Unset = that source reports NOT_CONFIGURED
# and is skipped by Scout; nothing is faked in its place.
# ---------------------------------------------------------------------------

# Web Search (Brave) — https://api.search.brave.com — real, works once set.
# BRAVE_SEARCH_API_KEY=""

# Meta Ad Library — official public Graph API ads_archive endpoint.
# Needs a Graph API access token with Ad Library Insights access.
# META_AD_LIBRARY_ACCESS_TOKEN=""

# Competitor Storefronts — reads the public, unauthenticated
# /products.json feed on the Shopify stores you list here (comma-separated
# domains, no https://, e.g. "store-a.com,store-b.com"). Opt-in only.
# COMPETITOR_STORE_DOMAINS=""

# Google Trends — no self-serve official API exists yet; always
# NOT_CONFIGURED regardless of env vars (see services/research/providers/googleTrends.ts).

# TikTok Shop — requires approved TikTok Shop Partner/Seller API access.
# TIKTOK_SHOP_APP_KEY=""
# TIKTOK_SHOP_APP_SECRET=""
# TIKTOK_SHOP_ACCESS_TOKEN=""

# Amazon Marketplace — requires an Amazon Associates account with
# qualifying sales history before PA-API credentials are issued.
# AMAZON_PAAPI_ACCESS_KEY=""
# AMAZON_PAAPI_SECRET_KEY=""
# AMAZON_PAAPI_PARTNER_TAG=""

# ---------------------------------------------------------------------------
# Supplier providers (Parts 5-8) — services/suppliers/providers
# ---------------------------------------------------------------------------

# CJ Dropshipping (official API 2.0 — developers.cjdropshipping.com).
# Provide EITHER a pre-generated access token, OR an API key so the app can
# request one itself via the official getAccessToken endpoint.
# CJ_ACCESS_TOKEN=""
# CJ_API_KEY=""

# Zendrop (official MCP server — app.zendrop.com/mcp/v1).
# ZENDROP_API_KEY=""
# ZENDROP_MCP_URL="https://app.zendrop.com/mcp/v1"

# HyperSKU — no public self-serve API in this environment; requires
# contacting HyperSKU's integration team for Open API access.
# HYPERSKU_API_KEY=""
# HYPERSKU_API_BASE_URL=""

# AliExpress — requires an approved Open Platform Dropshipping/Affiliate
# API application (openservice.aliexpress.com). Signed-request client not
# implemented until approved credentials exist.
# ALIEXPRESS_APP_KEY=""
# ALIEXPRESS_APP_SECRET=""
# ALIEXPRESS_ACCESS_TOKEN=""

# ---------------------------------------------------------------------------
# Phase 3+ — NOT used by anything through Phase 2.
#
# Placeholders for the services still stubbed out under /services. Every
# one is read through lib/env.ts, which reports the service as
# NOT_CONFIGURED when the variable is absent — the app never pretends an
# integration is live because a key happens to be unset.
# ---------------------------------------------------------------------------

# /services/shopify
# SHOPIFY_STORE_DOMAIN=""
# SHOPIFY_ADMIN_API_ACCESS_TOKEN=""

# /services/domains
# DOMAIN_REGISTRAR_API_KEY=""

# /services/images
# IMAGE_GENERATION_API_KEY=""

# /services/meta
# META_ACCESS_TOKEN=""
# META_AD_ACCOUNT_ID=""

# /services/tiktok
# TIKTOK_ACCESS_TOKEN=""
# TIKTOK_ADVERTISER_ID=""
