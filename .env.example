# ---------------------------------------------------------------------------
# BULLRUSH Internal E-Commerce Agent — environment variables
#
# Copy this file to .env for local development:
#   cp .env.example .env
#
# Never commit a real .env file. This file only ever contains placeholders.
# ---------------------------------------------------------------------------

# Required. PostgreSQL connection string used by Prisma.
DATABASE_URL="postgresql://user:password@localhost:5432/bullrush_agent"

# ---------------------------------------------------------------------------
# Phase 2+ — NOT used by anything in Phase 1.
#
# These are placeholders for the services stubbed out under /services and
# /agents. Every one of them is read through lib/env.ts, which reports the
# service as NOT_CONFIGURED when the variable is absent — the app never
# pretends an integration is live because a key happens to be unset.
# Leave them unset until you are actually building that integration.
# ---------------------------------------------------------------------------

# /services/shopify
# SHOPIFY_STORE_DOMAIN=""
# SHOPIFY_ADMIN_API_ACCESS_TOKEN=""

# /services/domains
# DOMAIN_REGISTRAR_API_KEY=""

# /services/suppliers
# SUPPLIER_SOURCING_API_KEY=""

# /services/images
# IMAGE_GENERATION_API_KEY=""

# /services/meta
# META_ACCESS_TOKEN=""
# META_AD_ACCOUNT_ID=""

# /services/tiktok
# TIKTOK_ACCESS_TOKEN=""
# TIKTOK_ADVERTISER_ID=""
